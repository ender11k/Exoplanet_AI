 right ascension coordinate type                CTYPE2  = 'DEC--TAN'           / declination coordinate type                    CRPIX1  =    3.801035936659673 / [pixel] reference pixel along image axis 1     CRPIX2  =   3.6395747242271455 / [pixel] reference pixel along image axis 2     CRVAL1  =            291.60717 / [deg] right ascension at reference pixel       CRVAL2  =             38.41039 / [deg] declination at reference pixel           CUNIT1  = 'deg     '           / physical unit in column dimension              CUNIT2  = 'deg     '           / physical unit in row dimension                 CDELT1  =   -0.001100920042681 / [deg] pixel scale in RA dimension              CDELT2  =    0.001100920042681 / [deg] pixel scale in Dec dimension             PC1_1   =   0.8412407025056007 / linear transformation element cos(th)          PC1_2   =   -0.532832154597953 / linear transformation element -sin(th)         PC2_1   =  -0.5374427568509754 / linear transformation element sin(th)          PC2_2   =  -0.8483103774799579 / linear transformation element cos(th)          WCSNAMEP= 'PHYSICAL'           / name of world coordinate system alternate P    WCSAXESP=                    2 / number of WCS physical axes                    CTYPE1P = 'RAWX    '           / physical WCS axis 1 type CCD col               CUNIT1P = 'PIXEL   '           / physical WCS axis 1 unit                       CRPIX1P =                    1 / reference CCD column                           CRVAL1P =                  965 / value at reference CCD column                  CDELT1P =                  1.0 / physical WCS axis 1 step                       CTYPE2P = 'RAWY    '           / physical WCS axis 2 type CCD row               CUNIT2P = 'PIXEL   '           / physical WCS axis 2 units                      CRPIX2P =                    1 / reference CCD row                              CRVAL2P =                  895 / value at reference CCD row                     CDELT2P =                  1.0 /